{
  "name": "sales-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-cli.js generate && node scripts/build.js",
    "start": "node scripts/start.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "node scripts/run-with-env.js npx tsx scripts/phase1-isolation-test.ts",
    "db:generate": "node scripts/prisma-cli.js generate",
    "db:push": "node scripts/prisma-cli.js db push",
    "db:migrate": "node scripts/prisma-cli.js migrate dev",
    "db:migrate:deploy": "node scripts/prisma-cli.js migrate deploy",
    "db:seed": "node scripts/run-with-env.js npx tsx prisma/seed.ts",
    "db:backfill:phase1": "node scripts/run-with-env.js npx tsx scripts/phase1-backfill.ts",
    "db:migrate:safe": "node scripts/run-with-env.js node scripts/safe-migrate-tenancy.js",
    "db:studio": "node scripts/prisma-cli.js studio",
    "db:reset": "node scripts/prisma-cli.js migrate reset",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
