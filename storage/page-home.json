from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@keyframes dxFadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}\n.dx-float{animation:dxFloat 6s ease-in-out infinite}\n.dx-float2{animation:dxFloat 7s ease-in-out 1s infinite}\n.dx-marquee{animation:dxMarquee 40s linear infinite}\n.dx-fade{animation:dxFadeUp .7s ease-out both}\n.dx-card{transition:transform .2s ease,border-color .2s ease}\n.dx-card:hover{transform:translateY(-4px);border-color:#6366F1 !important}\n@media (prefers-reduced-motion: reduce){.dx-float,.dx-float2,.dx-marquee,.dx-fade{animation:none}.dx-card{transition:none}}\n</style>\n</helmet>\n<div style=\"width: 100%; background: #0B1220; color: #F5F7FB\">\n\n<dc-import name=\"Header\" hint-size=\"100%,124px\"></dc-import>\n\n<!-- 1. HERO -->\n<section style=\"position: relative; overflow: hidden; padding: 96px 24px 112px; background-color: #0B1220; background-image: linear-gradient(#141D30 1px, transparent 1px), linear-gradient(90deg, #141D30 1px, transparent 1px); background-size: 56px 56px\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 56px; align-items: center\">\n<div class=\"dx-fade\" style=\"flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px\">\n<span style=\"align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; border: 1px solid #2A3550; background: #121A2B; font-size: 13px; color: #A3ADC2\"><span style=\"width: 8px; height: 8px; border-radius: 999px; background: #22C55E\"></span>Remote software studio · US, UK, EU and Gulf hours</span>\n<h1 style=\"margin: 0; font-size: clamp(40px, 5.2vw, 64px); line-height: 1.05; font-weight: 800; color: #F5F7FB\">We build the systems your business runs on.</h1>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.6; color: #A3ADC2; max-width: 560px\">Web apps, mobile apps, ERP, CRM and AI automation. Scoped in writing, demoed every week, and handed over with full code ownership.</p>\n<div style=\"display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px\">\n<a href=\"#book\" style=\"display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; border-radius: 12px; background: #6366F1; color: #FFFFFF; font-weight: 600; font-size: 16px; text-decoration: none\">Book a free call<svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n<a href=\"#work\" style=\"display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; border-radius: 12px; border: 1px solid #2A3550; color: #F5F7FB; font-weight: 600; font-size: 16px; text-decoration: none\">See our work</a>\n</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 20px; margin-top: 12px\">\n<sc-for list=\"{{promisesShort}}\" as=\"p\" hint-placeholder-count=\"3\">\n<span style=\"display: inline-flex; align-items: center; gap: 8px; font-size: 15px; color: #D5DBE8\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#A5B4FC\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"></path></svg>{{p}}</span>\n</sc-for>\n</div>\n</div>\n<div style=\"flex: 1 1 520px; min-width: 0; position: relative\">\n<div style=\"position: absolute; inset: 8% 4% auto 4%; height: 70%; border-radius: 999px; background: #6366F1; opacity: 0.22; filter: blur(80px)\"></div>\n<div class=\"dx-float\" style=\"position: relative; border-radius: 18px; border: 1px solid #2A3550; background: #121A2B; padding: 10px; box-shadow: 0 40px 80px rgba(0,0,0,0.45)\">\n<div style=\"display: flex; gap: 6px; padding: 6px 8px 12px\"><span style=\"width: 10px; height: 10px; border-radius: 999px; background: #3A4660\"></span><span style=\"width: 10px; height: 10px; border-radius: 999px; background: #3A4660\"></span><span style=\"width: 10px; height: 10px; border-radius: 999px; background: #3A4660\"></span></div>\n<div style=\"aspect-ratio: 16 / 10; border-radius: 12px; border: 1.5px dashed #3A4660; background: #0E1626; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 24px; text-align: center; color: #A3ADC2; font-size: 14px\">\n<svg width=\"32\" height=\"32\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#A5B4FC\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h18v18H3zM8.5 10a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21\"></path></svg>\n<strong style=\"color: #F5F7FB\">HOME-01 · Hero product shot</strong>\n<span>Revenue OS dashboard, real screenshot · 1600×1000 · blur client names</span>\n</div>\n</div>\n<div class=\"dx-float2\" style=\"position: absolute; left: -20px; bottom: 36px; display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 14px; background: #F5F7FB; color: #0B1220; box-shadow: 0 20px 40px rgba(0,0,0,0.35)\">\n<span style=\"width: 36px; height: 36px; border-radius: 10px; background: #EEF0FF; display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#4F46E5\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h6\"></path></svg></span>\n<span style=\"display: flex; flex-direction: column\"><strong style=\"font-size: 14px\">Written scope</strong><span style=\"font-size: 13px; color: #4B5568\">Delivered in 3 days</span></span>\n</div>\n<div class=\"dx-float\" style=\"position: absolute; right: -12px; top: 28px; display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 14px; background: #F5F7FB; color: #0B1220; box-shadow: 0 20px 40px rgba(0,0,0,0.35)\">\n<span style=\"width: 36px; height: 36px; border-radius: 10px; background: #EEF0FF; display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#4F46E5\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 4l14 8-14 8z\"></path></svg></span>\n<span style=\"display: flex; flex-direction: column\"><strong style=\"font-size: 14px\">Demo every week</strong><span style=\"font-size: 13px; color: #4B5568\">See real progress</span></span>\n</div>\n</div>\n</div>\n</section>\n\n<!-- 2. PROMISE MARQUEE -->\n<section style=\"border-top: 1px solid #1E2738; border-bottom: 1px solid #1E2738; background: #0E1626; overflow: hidden; padding: 22px 0\" aria-label=\"What every project gets\">\n<div class=\"dx-marquee\" style=\"display: flex; gap: 56px; width: max-content; white-space: nowrap\">\n<sc-for list=\"{{marquee}}\" as=\"m\" hint-placeholder-count=\"10\">\n<span style=\"display: inline-flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500; color: #D5DBE8\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#A5B4FC\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{{m.icon}}\"></path></svg>{{m.text}}</span>\n</sc-for>\n</div>\n</section>\n\n<!-- 3. SERVICES -->\n<section style=\"background: #FFFFFF; color: #0B1220; padding: 112px 24px\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 48px\">\n<div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px\">\n<div style=\"display: flex; flex-direction: column; gap: 14px; max-width: 640px\">\n<span style=\"font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4F46E5\">What we build</span>\n<h2 style=\"margin: 0; font-size: clamp(32px, 3.6vw, 44px); line-height: 1.12; font-weight: 800\">One studio for the software behind your operations.</h2>\n</div>\n<a href=\"/services\" style=\"color: #4F46E5; font-weight: 600; text-decoration: none; display: inline-flex; gap: 8px; align-items: center\">All services<svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"></path></svg></a>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px\">\n<sc-for list=\"{{services}}\" as=\"s\" hint-placeholder-count=\"8\">\n<a href=\"{{s.href}}\" class=\"dx-card\" style=\"display: flex; flex-direction: column; gap: 14px; padding: 28px; border-radius: 16px; border: 1px solid #E4E7EF; background: #FFFFFF; color: #0B1220; text-decoration: none\">\n<span style=\"width: 48px; height: 48px; border-radius: 12px; background: #EEF0FF; display: flex; align-items: center; justify-content: center\"><svg width=\"24\" height=\"24\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#4F46E5\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{{s.icon}}\"></path></svg></span>\n<h3 style=\"margin: 0; font-size: 20px; font-weight: 700\">{{s.title}}</h3>\n<p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: #4B5568\">{{s.text}}</p>\n<span style=\"margin-top: auto; font-size: 14px; font-weight: 600; color: #4F46E5\">Learn more →</span>\n</a>\n</sc-for>\n</div>\n</div>\n</section>\n\n<!-- 4. AI FEATURE SPLIT -->\n<section style=\"background: #0B1220; padding: 112px 24px\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center\">\n<div style=\"flex: 1 1 480px; min-width: 0\">\n<div style=\"aspect-ratio: 5 / 4; border-radius: 18px; border: 1.5px dashed #3A4660; background: #121A2B; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 24px; text-align: center; color: #A3ADC2; font-size: 14px\">\n<svg width=\"32\" height=\"32\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#A5B4FC\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h18v18H3zM8.5 10a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21\"></path></svg>\n<strong style=\"color: #F5F7FB\">HOME-02 · AI in action</strong>\n<span>Screenshot: Revenue OS deep audit findings or an AI reply draft · 1500×1200</span>\n</div>\n</div>\n<div style=\"flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 22px\">\n<span style=\"font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #A5B4FC\">AI development</span>\n<h2 style=\"margin: 0; font-size: clamp(32px, 3.6vw, 44px); line-height: 1.12; font-weight: 800; color: #F5F7FB\">AI that works on your data, inside your tools.</h2>\n<p style=\"margin: 0; font-size: 17px; line-height: 1.65; color: #A3ADC2\">We connect OpenAI and Claude to your CRM, inbox, documents and databases, with clear limits on what the AI can do on its own.</p>\n<div style=\"display: flex; flex-direction: column; gap: 14px\">\n<sc-for list=\"{{aiPoints}}\" as=\"a\" hint-placeholder-count=\"4\">\n<div style=\"display: flex; gap: 14px; padding: 16px; border-radius: 14px; border: 1px solid #1E2738; background: #121A2B\">\n<span style=\"flex: 0 0 40px; height: 40px; border-radius: 10px; background: #1B2340; display: flex; align-items: center; justify-content: center\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#A5B4FC\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{{a.icon}}\"></path></svg></span>\n<span style=\"display: flex; flex-direction: column; gap: 4px\"><strong style=\"font-size: 16px; color: #F5F7FB\">{{a.title}}</strong><span style=\"font-size: 14px; line-height: 1.55; color: #A3ADC2\">{{a.text}}</span></span>\n</div>\n</sc-for>\n</div>\n<a href=\"/ai\" style=\"align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; border-radius: 12px; border: 1px solid #2A3550; color: #F5F7FB; font-weight: 600; text-decoration: none\">Explore AI services</a>\n</div>\n</div>\n</section>\n\n<!-- 5. PROCESS -->\n<section style=\"background: #F5F7FB; color: #0B1220; padding: 112px 24px\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 56px\">\n<div style=\"display: flex; flex-direction: column; gap: 14px; max-width: 700px\">\n<span style=\"font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4F46E5\">How we work</span>\n<h2 style=\"margin: 0; font-size: clamp(32px, 3.6vw, 44px); line-height: 1.12; font-weight: 800\">From first call to launch, with no surprises.</h2>\n<p style=\"margin: 0; font-size: 17px; line-height: 1.65; color: #4B5568\">You always know what is being built, what it costs and what you will see next Friday.</p>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; position: relative\">\n<sc-for list=\"{{steps}}\" as=\"st\" hint-placeholder-count=\"6\">\n<div style=\"display: flex; flex-direction: column; gap: 12px; padding: 24px 20px; border-radius: 16px; background: #FFFFFF; border: 1px solid #E4E7EF\">\n<span style=\"font-family: 'Plus Jakarta Sans', sans-serif; font-size: 32px; font-weight: 800; color: #4F46E5\">{{st.n}}</span>\n<h3 style=\"margin: 0; font-size: 17px; font-weight: 700\">{{st.title}}</h3>\n<p style=\"margin: 0; font-size: 14px; line-height: 1.55; color: #4B5568\">{{st.text}}</p>\n</div>\n</sc-for>\n</div>\n</div>\n</section>\n\n<!-- 6. ENGAGEMENT MODELS -->\n<section style=\"background: #FFFFFF; color: #0B1220; padding: 112px 24px\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 48px\">\n<div style=\"display: flex; flex-direction: column; gap: 14px; max-width: 700px\">\n<span style=\"font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4F46E5\">Ways to work together</span>\n<h2 style=\"margin: 0; font-size: clamp(32px, 3.6vw, 44px); line-height: 1.12; font-weight: 800\">Pick the model that fits the work.</h2>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; align-items: stretch\">\n<sc-for list=\"{{models}}\" as=\"md\" hint-placeholder-count=\"3\">\n<div style=\"display: flex; flex-direction: column; gap: 18px; padding: 32px; border-radius: 18px; border: {{md.border}}; background: {{md.bg}}; color: {{md.fg}}\">\n<sc-if value=\"{{md.featured}}\" hint-placeholder-val=\"{{ false }}\"><span style=\"align-self: flex-start; padding: 4px 12px; border-radius: 999px; background: #6366F1; color: #FFFFFF; font-size: 12px; font-weight: 600\">Most common</span></sc-if>\n<h3 style=\"margin: 0; font-size: 24px; font-weight: 800\">{{md.title}}</h3>\n<p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: {{md.muted}}\">{{md.text}}</p>\n<div style=\"display: flex; flex-direction: column; gap: 10px\">\n<sc-for list=\"{{md.points}}\" as=\"pt\" hint-placeholder-count=\"3\">\n<span style=\"display: flex; gap: 10px; font-size: 15px; line-height: 1.5\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#6366F1\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex: 0 0 18px; margin-top: 2px\"><path d=\"M20 6L9 17l-5-5\"></path></svg>{{pt}}</span>\n</sc-for>\n</div>\n<a href=\"/pricing\" style=\"margin-top: auto; text-align: center; padding: 14px 20px; border-radius: 12px; background: {{md.btnBg}}; color: {{md.btnFg}}; font-weight: 600; text-decoration: none\">Get pricing</a>\n</div>\n</sc-for>\n</div>\n</div>\n</section>\n\n<!-- 7. WHY