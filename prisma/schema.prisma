  userId            String                 @unique @map("user_id")
  connectionType    LinkedInConnectionType @default(OAUTH) @map("connection_type")
  linkedInEmail     String?                @map("linkedin_email")
  displayName       String?                @map("display_name")
  linkedInMemberId  String?                @map("linkedin_member_id")
  liAtCookie        String?                @map("li_at_cookie")
  jsessionId        String?                @map("jsession_id")
  oauthAccessToken  String?                @map("oauth_access_token")
  oauthRefreshToken String?                @map("oauth_refresh_token")
  oauthExpiresAt    DateTime?              @map("oauth_expires_at")
  profileUrn        String?                @map("profile_urn")
  isActive          Boolean                @default(true) @map("is_active")
  lastVerifiedAt    DateTime?              @map("last_verified_at")
  dailySearchCount  Int                    @default(0) @map("daily_search_count")
  dailyMessageCount Int                    @default(0) @map("daily_message_count")
  lastResetAt       DateTime?              @map("last_reset_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("linkedin_accounts")
}

model AutopilotConfig {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  userId              String    @unique @map("user_id")
  isEnabled           Boolean   @default(false) @map("is_enabled")
  goal                String?
  targetJobTitles     String[]  @default([]) @map("target_job_titles")
  targetIndustries    String[]  @default([]) @map("target_industries")
  targetCountries     String[]  @default([]) @map("target_countries")
  dailySearchLimit    Int       @default(5) @map("daily_search_limit")
  dailyMessageLimit   Int       @default(5) @map("daily_message_limit")
  maxLeadsPerRun      Int       @default(5) @map("max_leads_per_run")
  maxLeadsPerDay      Int       @default(10) @map("max_leads_per_day")
  dailyLeadsCreated   Int       @default(0) @map("daily_leads_created")
  dailyEmailsSent     Int       @default(0) @map("daily_emails_sent")
  dailyAiCalls        Int       @default(0) @map("daily_ai_calls")
  maxAiCallsPerDay    Int       @default(15) @map("max_ai_calls_per_day")
  dailyResetAt        DateTime? @map("daily_reset_at")
  autoCreateCampaigns Boolean   @default(true) @map("auto_create_campaigns")
  serviceId           String?   @map("service_id")
  activeCampaignId    String?   @map("active_campaign_id")
  lastRunAt           DateTime? @map("last_run_at")
  nextRunAt           DateTime? @map("next_run_at")
  lastRunResult       Json?     @map("last_run_result")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service        Service?     @relation(fields: [serviceId], references: [id])
  activeCampaign Campaign?    @relation(fields: [activeCampaignId], references: [id])

  @@index([organizationId])
  @@map("autopilot_configs")
}

// ─── AI & Audit ──────────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  messages  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_conversations")
}

model AIUsageLog {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  userId         String?        @map("user_id")
  feature        String
  /// Canonical operation name (e.g. opportunity_intelligence)
  operation      String?
  provider       String?
  model          String?
  promptTokens   Int?           @map("prompt_tokens")
  outputTokens   Int?           @map("output_tokens")
  totalTokens    Int?           @map("total_tokens")
  cost           Decimal?       @db.Decimal(10, 6)
  requestId      String?        @map("request_id")
  status         AIUsageStatus  @default(SUCCESS)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([feature])
  @@index([operation])
  @@index([requestId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Phase 8: AI Recommendations ──────────────────────────────────────────────

enum AiRecommendationType {
  DAILY_PRIORITY
  FOLLOW_UP
  OUTREACH
  MEETING
  PROPOSAL
  STOP_PURSUING
  LEARNING_INSIGHT
  OTHER
}

enum AiRecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  COMPLETED
  EXPIRED
}

enum AiRecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AiRecommendation {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  type           AiRecommendationType     @default(DAILY_PRIORITY)
  entityType     String?                  @map("entity_type")
  entityId       String?                  @map("entity_id")
  title          String
  description    String?
  reason         String
  priority       AiRecommendationPriority @default(MEDIUM)
  confidence     Int                      @default(50)
  expectedImpact String?                  @map("expected_impact")
  action         String
  status         AiRecommendationStatus   @default(PENDING)
  createdAt      DateTime                 @default(now()) @map("created_at")
  expiresAt      DateTime?                @map("expires_at")
  resolvedAt     DateTime?                @map("resolved_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("ai_recommendations")
}

// ─── Phase 9: Sales Learning Engine ──────────────────────────────────────────

enum LearningEventType {
  OPPORTUNITY_CREATED
  CONTACTED
  REPLIED
  POSITIVE_REPLY
  NEGATIVE_REPLY
  MEETING
  PROPOSAL
  WON
  LOST
  REVENUE
  SERVICE_SELECTED
  OFFER_SELECTED
  MESSAGE_SENT
  CHANNEL_USED
  SIGNAL_TYPE
  OTHER
}

model LearningEvent {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  opportunityId  String?           @map("opportunity_id")
  eventType      LearningEventType @map("event_type")
  inputContext   Json?             @map("input_context")
  action         String?
  result         String?
  revenue        Decimal?          @db.Decimal(14, 2)
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([opportunityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("learning_events")
}

// ─── Phase 10: Billing + Plans + Usage + Entitlements ────────────────────────

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
  INCOMPLETE_EXPIRED
}

enum UsageMetric {
  AI_CALLS
  TOKENS
  EMAILS
  OPPORTUNITIES
  ENRICHMENT
  SOURCE_CALLS
  AUTOMATION_RUNS
  USERS
  SEQUENCES
  INBOX_ACCOUNTS
}

model Plan {
  id              String          @id @default(uuid())
  name            String
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  stripePriceId   String?         @map("stripe_price_id")
  stripeProductId String?         @map("stripe_product_id")
  active          Boolean         @default(true)
  sortOrder       Int             @default(0) @map("sort_order")
  isDefault       Boolean         @default(false) @map("is_default")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@index([active])
  @@map("plans")
}

model PlanFeature {
  id         String   @id @default(uuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key")
  limitValue Int?     @map("limit_value")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("plan_features")
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @map("organization_id")
  planId                 String             @map("plan_id")
  provider               String             @default("stripe")
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@unique([organizationId])
  @@index([planId])
  @@index([status])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@map("subscriptions")
}

model UsageRecord {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  metric         UsageMetric
  periodStart    DateTime    @map("period_start") @db.Date
  quantity       Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId])
  @@index([metric])
  @@map("usage_records")
}

/// Idempotent Stripe (or other) webhook event store
model BillingWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("stripe")
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  payload     Json?
  processedAt DateTime @default(now()) @map("processed_at")
  status      String   @default("processed")
  error       String?

  @@index([eventType])
  @@index([processedAt])
  @@map("billing_webhook_events")
}

// ─── Autonomous AI Revenue Agent (Phase 12) ─────────────────────────────────

enum AgentGoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  QUEUED
  AUTHORIZED
  AWAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  DENIED
}

enum AgentActionType {
  READ_CONTEXT
  ENSURE_ICP
  RUN_SOURCE_CONNECTOR
  CREATE_OPPORTUNITY
  SCORE_OPPORTUNITY
  RESEARCH_OPPORTUNITY
  RECOMMEND_SERVICE
  FIND_DECISION_MAKER
  CREATE_CAMPAIGN
  CREATE_SEQUENCE
  DRAFT_OUTREACH
  SEND_OUTREACH
  WATCH_REPLIES
  SUGGEST_FOLLOW_UP
  BOOK_MEETING
  PREPARE_PROPOSAL
  SEND_PROPOSAL
  CHANGE_PRICE
  TRACK_DEAL
  MEASURE_REVENUE
  LEARN
  CREATE_TASK
  INTERNAL_RECOMMENDATION
  PRIORITIZE
  CLASSIFY
  SUMMARIZE
  ENABLE_DATA_PROVIDER
  EXPENSIVE_AI
  UNUSUAL_VOLUME
}

model AgentGoal {
  id               String          @id @default(uuid())
  organizationId   String          @map("organization_id")
  revenueGoalId    String          @map("revenue_goal_id")
  name             String
  objective        String
  constraints      Json?
  allowedChannels  String[]        @default([]) @map("allowed_channels")
  allowedActions   String[]        @default([]) @map("allowed_actions")
  approvalPolicy   Json            @map("approval_policy")
  maxDailyActions  Int             @default(50) @map("max_daily_actions")
  maxDailySpend    Decimal         @default(0) @map("max_daily_spend") @db.Decimal(12, 2)
  status           AgentGoalStatus @default(DRAFT)
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revenueGoal  RevenueGoal  @relation(fields: [revenueGoalId], references: [id], onDelete: Cascade)
  runs         AgentRun[]
  actions      AgentAction[]

  @@index([organizationId])
  @@index([revenueGoalId])
  @@index([status])
  @@map("agent_goals")
}

model AgentRun {
  id                 String         @id @default(uuid())
  organizationId     String         @map("organization_id")
  agentGoalId        String         @map("agent_goal_id")
  status             AgentRunStatus @default(PENDING)
  triggeredBy        String         @default("USER") @map("triggered_by")
  idempotencyKey     String         @map("idempotency_key")
  startedAt          DateTime?      @map("started_at")
  completedAt        DateTime?      @map("completed_at")
  actionsCount       Int            @default(0) @map("actions_count")
  successfulActions  Int            @default(0) @map("successful_actions")
  failedActions      Int            @default(0) @map("failed_actions")
  summary            String?
  error              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentGoal    AgentGoal     @relation(fields: [agentGoalId], references: [id], onDelete: Cascade)
  actions      AgentAction[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([agentGoalId])
  @@index([status])
  @@map("agent_runs")
}

model AgentAction {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  agentRunId       String            @map("agent_run_id")
  agentGoalId      String            @map("agent_goal_id")
  entityType       String?           @map("entity_type")
  entityId         String?           @map("entity_id")
  actionType       AgentActionType   @map("action_type")
  input            Json?
  result           Json?
  status           AgentActionStatus @default(QUEUED)
  requiresApproval Boolean           @default(false) @map("requires_approval")
  idempotencyKey   String            @map("idempotency_key")
  approvedById     String?           @map("approved_by")
  approvedAt       DateTime?         @map("approved_at")
  executedAt       DateTime?         @map("executed_at")
  error            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentGoal    AgentGoal    @relation(fields: [agentGoalId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([agentRunId])
  @@index([agentGoalId])
  @@index([status])
  @@index([actionType])
  @@index([requiresApproval])
  @@map("agent_actions")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
