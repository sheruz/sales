// ─── Phase 10: Billing + Plans + Usage + Entitlements ────────────────────────

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  /// B1: no package yet (locked)
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
  INCOMPLETE_EXPIRED
  SUSPENDED
  /// B1: trial ended without payment (locked, data kept)
  EXPIRED
}

enum PlanVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
  DRAFT
}

/// B2: draft PlanVersion rows are editor-only; published are immutable.
enum PlanVersionStatus {
  DRAFT
  PUBLISHED
}

/// B2: seat-limit reduction notice window.
enum PlanLimitNoticeStatus {
  PENDING
  RESOLVED
  APPLIED
}

enum TenantIntegrationStatus {
  CONNECTED
  NEEDS_RECONNECT
  ERROR
  DISCONNECTED
}

enum IntegrationOAuthMode {
  PLATFORM_APP
  TENANT_APP
}

enum IntegrationKeyMode {
  BYOK
  MANAGED
}

enum UsageMetric {
  AI_CALLS
  TOKENS
  EMAILS
  EMAILS_DAILY
  OPPORTUNITIES
  ENRICHMENT
  AUDITS
  SOURCE_CALLS
  CRAWLS
  AUTOMATION_RUNS
  MEETINGS
  USERS
  SEQUENCES
  INBOX_ACCOUNTS
  ICPS
  CAMPAIGNS
}

model Plan {
  id              String          @id @default(uuid())
  name            String
  /// Stable plan code (e.g. OWNER, FREE, STARTER). Additive S1.
  code            String?         @unique
  description     String?
  /// Legacy catalog price (B1+: prefer PlanVersion.priceMonthly/Yearly)
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  stripePriceId   String?         @map("stripe_price_id")
  stripeProductId String?         @map("stripe_product_id")
  active          Boolean         @default(true)
  sortOrder       Int             @default(0) @map("sort_order")
  isDefault       Boolean         @default(false) @map("is_default")
  visibility      PlanVisibility  @default(PUBLIC)
  /// S2 monthly credit grant (null = none; OWNER ignores) — legacy; prefer PlanVersion
  monthlyCredits        Int?     @map("monthly_credits")
  creditRolloverEnabled Boolean  @default(false) @map("credit_rollover_enabled")
  creditRolloverCap     Int?     @map("credit_rollover_cap")
  /// B1: highlight on Choose Plan
  mostPopular     Boolean         @default(false) @map("most_popular")
  /// B1: published version id for new subscribers (no FK — avoids Plan↔Version cycle)
  currentVersionId String?        @map("current_version_id")
  archivedAt      DateTime?       @map("archived_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  /// Legacy flat features — transition fallback only; remove after B1 verify
  features       PlanFeature[]
  versions       PlanVersion[]
  subscriptions  Subscription[]

  @@index([active])
  @@index([visibility])
  @@index([archivedAt])
  @@index([currentVersionId])
  @@map("plans")
}

/// Package snapshot (B1). Published versions are immutable; drafts are editable (B2).
model PlanVersion {
  id                      String            @id @default(uuid())
  planId                  String            @map("plan_id")
  version                 Int
  /// B2: DRAFT = editor working copy; PUBLISHED = immutable history
  status                  PlanVersionStatus @default(PUBLISHED)
  /// B2 optimistic lock for draft saves
  editorRevision          Int               @default(0) @map("editor_revision")
  priceMonthly            Decimal           @map("price_monthly") @db.Decimal(12, 2)
  priceYearly             Decimal           @map("price_yearly") @db.Decimal(12, 2)
  currency                String            @default("USD")
  monthlyCredits          Int?              @map("monthly_credits")
  creditRolloverEnabled   Boolean           @default(false) @map("credit_rollover_enabled")
  /// Max months of unused credits that may roll (null = none / N/A)
  creditRolloverCapMonths Int?              @map("credit_rollover_cap_months")
  stripePriceIdMonthly    String?           @map("stripe_price_id_monthly")
  stripePriceIdYearly     String?           @map("stripe_price_id_yearly")
  notes                   String?
  createdByUserId         String?           @map("created_by_user_id")
  publishedAt             DateTime?         @map("published_at")
  publishedByUserId       String?           @map("published_by_user_id")
  /// now | renewal | new_subscribers_only
  applyMode               String?           @map("apply_mode")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  plan                   Plan                    @relation(fields: [planId], references: [id], onDelete: Cascade)
  features               PlanVersionFeature[]
  subscriptions          Subscription[]          @relation("SubPlanVersion")
  pendingSubscriptions   Subscription[]          @relation("SubPendingPlanVersion")
  limitNotices           PlanLimitNotice[]
  providerPriceMaps      ProviderPriceMap[]

  @@unique([planId, version])
  @@index([planId])
  @@index([status])
  @@map("plan_versions")
}

model PlanVersionFeature {
  id            String   @id @default(uuid())
  planVersionId String   @map("plan_version_id")
  featureKey    String   @map("feature_key")
  limitValue    Int?     @map("limit_value")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureKey])
  @@index([featureKey])
  @@map("plan_version_features")
}

model PlanFeature {
  id         String   @id @default(uuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key")
  limitValue Int?     @map("limit_value")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("plan_features")
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @map("organization_id")
  planId                 String             @map("plan_id")
  /// B1: pinned package version (grandfathering)
  planVersionId          String?            @map("plan_version_id")
  /// B1: apply at renewal
  pendingPlanVersionId   String?            @map("pending_plan_version_id")
  pendingApplyAt         DateTime?          @map("pending_apply_at")
  /// B3: provider the active subscription actually uses (PADDLE | MANUAL_* | internal | stripe stub)
  provider               String             @default("PADDLE")
  /// none | trial | manual | complimentary | paddle
  accessMode             String?            @map("access_mode")
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")
  /// B3: sandbox | production — never reuse across envs
  providerEnvironment    String?            @map("provider_environment")
  billingInterval        String?            @map("billing_interval")
  status                 SubscriptionStatus @default(NONE)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  gracePeriodEndsAt      DateTime?          @map("grace_period_ends_at")
  /// After CANCELED period end: read-only + export until this date
  readOnlyUntil          DateTime?          @map("read_only_until")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  /// B3: last failed payment notice day (0/3/6)
  lastPaymentFailedNoticeDay Int?           @map("last_payment_failed_notice_day")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan         @relation(fields: [planId], references: [id])
  planVersion        PlanVersion? @relation("SubPlanVersion", fields: [planVersionId], references: [id], onDelete: SetNull)
  pendingPlanVersion PlanVersion? @relation("SubPendingPlanVersion", fields: [pendingPlanVersionId], references: [id], onDelete: SetNull)

  @@unique([organizationId])
  @@index([planId])
  @@index([planVersionId])
  @@index([status])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@index([trialEndsAt])
  @@index([gracePeriodEndsAt])
  @@index([pendingApplyAt])
  @@map("subscriptions")
}

model UsageRecord {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  metric         UsageMetric
  periodStart    DateTime    @map("period_start") @db.Date
  quantity       Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId])
  @@index([metric])
  @@map("usage_records")
}

/// Idempotent provider webhook event store (B3: Paddle primary)
model BillingWebhookEvent {
  id                     String    @id @default(uuid())
  provider               String    @default("paddle")
  environment            String?   // sandbox | production
  eventId                String    @unique @map("event_id")
  eventType              String    @map("event_type")
  payload                Json?
  occurredAt             DateTime? @map("occurred_at")
  organizationId         String?   @map("organization_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  /// received | processing | processed | error | unmatched
  status                 String    @default("received")
  error                  String?
  attemptCount           Int       @default(0) @map("attempt_count")
  nextRetryAt            DateTime? @map("next_retry_at")
  processedAt            DateTime? @map("processed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([eventType])
  @@index([processedAt])
  @@index([status, nextRetryAt])
  @@index([organizationId])
  @@map("billing_webhook_events")
}

/// B3: provider product/price ids per environment (never cross sandbox↔production)
model ProviderPriceMap {
  id                String   @id @default(uuid())
  provider          String   // PADDLE
  environment       String   // sandbox | production
  /// MONTHLY | YEARLY | ONE_TIME
  interval          String
  planVersionId     String?  @map("plan_version_id")
  topUpPackId       String?  @map("top_up_pack_id")
  externalProductId String   @map("external_product_id")
  externalPriceId   String   @map("external_price_id")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  planVersion PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  topUpPack   TopUpPack?   @relation(fields: [topUpPackId], references: [id], onDelete: Cascade)

  @@index([provider, environment, externalPriceId])
  @@index([planVersionId])
  @@index([topUpPackId])
  @@index([provider, environment, planVersionId, interval])
  @@index([provider, environment, topUpPackId, interval])
  @@map("provider_price_maps")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id             String        @id @default(uuid())
  number         String        @unique
  organizationId String        @map("organization_id")
  status         InvoiceStatus @default(DRAFT)
  provider       String
  currency       String        @default("USD")
  subtotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  dueDate        DateTime?     @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  periodStart    DateTime?     @map("period_start")
  periodEnd      DateTime?     @map("period_end")
  lineItems      Json          @map("line_items")
  paymentUrl     String?       @map("payment_url")
  pdfPath        String?       @map("pdf_path")
  billingName    String?       @map("billing_name")
  billingEmail   String?       @map("billing_email")
  billingAddress String?       @map("billing_address") @db.Text
  notes          String?       @db.Text
  paddleTransactionId String?  @map("paddle_transaction_id")
  planVersionId  String?       @map("plan_version_id")
  createdByUserId String?      @map("created_by_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId, status])
  @@index([status, dueDate])
  @@index([provider])
  @@map("invoices")
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  amount          Decimal  @db.Decimal(12, 2)
  method          String
  reference       String?
  receivedAt      DateTime @map("received_at")
  recordedByUserId String? @map("recorded_by_user_id")
  notes           String?  @db.Text
  proofPath       String?  @map("proof_path")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

/// Concurrency-safe invoice numbering DLX-YYYY-NNNN
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
}

// ─── Autonomous AI Revenue Agent (Phase 12) ─────────────────────────────────

enum AgentGoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  QUEUED
  AUTHORIZED
  AWAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  DENIED
}

enum AgentActionType {
  READ_CONTEXT
  ENSURE_ICP
  RUN_SOURCE_CONNECTOR
  CREATE_OPPORTUNITY
  SCORE_OPPORTUNITY
  RESEARCH_OPPORTUNITY
  RECOMMEND_SERVICE
  FIND_DECISION_MAKER
  CREATE_CAMPAIGN
  CREATE_SEQUENCE
  DRAFT_OUTREACH
  SEND_OUTREACH
  WATCH_REPLIES
  SUGGEST_FOLLOW_UP
  BOOK_MEETING
  PREPARE_PROPOSAL
  SEND_PROPOSAL
  CHANGE_PRICE
  TRACK_DEAL
  MEASURE_REVENUE
  LEARN
  CREATE_TASK
  INTERNAL_RECOMMENDATION
  PRIORITIZE
  CLASSIFY
  SUMMARIZE
  ENABLE_DATA_PROVIDER
  EXPENSIVE_AI
  UNUSUAL_VOLUME
}

model AgentGoal {
  id               String          @id @default(uuid())
  organizationId   String          @map("organization_id")
  revenueGoalId    String          @map("revenue_goal_id")
  name             String
  objective        String
  constraints      Json?
  allowedChannels  String[]        @default([]) @map("allowed_channels")
  allowedActions   String[]        @default([]) @map("allowed_actions")
  approvalPolicy   Json            @map("approval_policy")
  maxDailyActions  Int             @default(50) @map("max_daily_actions")
  maxDailySpend    Decimal         @default(0) @map("max_daily_spend") @db.Decimal(12, 2)
  status           AgentGoalStatus @default(DRAFT)
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revenueGoal  RevenueGoal  @relation(fields: [revenueGoalId], references: [id], onDelete: Cascade)
  runs         AgentRun[]
  actions      AgentAction[]

  @@index([organizationId])
  @@index([revenueGoalId])
  @@index([status])
  @@map("agent_goals")
}

model AgentRun {
  id                 String         @id @default(uuid())
  organizationId     String         @map("organization_id")
  agentGoalId        String         @map("agent_goal_id")
  status             AgentRunStatus @default(PENDING)
  triggeredBy        String         @default("USER") @map("triggered_by")
  idempotencyKey     String         @map("idempotency_key")
  startedAt          DateTime?      @map("started_at")
  completedAt        DateTime?      @map("completed_at")
  actionsCount       Int            @default(0) @map("actions_count")
  successfulActions  Int            @default(0) @map("successful_actions")
  failedActions      Int            @default(0) @map("failed_actions")
  summary            String?
  error              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentGoal    AgentGoal     @relation(fields: [agentGoalId], references: [id], onDelete: Cascade)
  actions      AgentAction[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([agentGoalId])
  @@index([status])
  @@map("agent_runs")
}

model AgentAction {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  agentRunId       String            @map("agent_run_id")
  agentGoalId      String            @map("agent_goal_id")
  entityType       String?           @map("entity_type")
  entityId         String?           @map("entity_id")
  actionType       AgentActionType   @map("action_type")
  input            Json?
  result           Json?
  status           AgentActionStatus @default(QUEUED)
  requiresApproval Boolean           @default(false) @map("requires_approval")
  idempotencyKey   String            @map("idempotency_key")
  approvedById     String?           @map("approved_by")
  approvedAt       DateTime?         @map("approved_at")
  executedAt       DateTime?         @map("executed_at")
  error            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentGoal    AgentGoal    @relation(fields: [agentGoalId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([agentRunId])
  @@index([agentGoalId])
  @@index([status])
  @@index([actionType])
  @@index([requiresApproval])
  @@map("agent_actions")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── S1: SaaS foundation (additive) ──────────────────────────────────────────

/// Per-tenant provider connection. providerId is a string catalog id (no enum).
model TenantIntegration {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  providerId           String                   @map("provider_id")
  /// Distinguishes multiple connections (e.g. mailbox email). Default "default".
  externalKey          String                   @default("default") @map("external_key")
  label                String?
  status               TenantIntegrationStatus  @default(DISCONNECTED)
  /// Encrypted credentials blob — never returned by APIs.
  encryptedCredentials String?                  @map("encrypted_credentials")
  publicConfig         Json?                    @map("public_config")
  oauthMode            IntegrationOAuthMode?    @map("oauth_mode")
  /// MANAGED = platform-billed key (future). Default BYOK. OFF/unused until offered.
  keyMode              IntegrationKeyMode       @default(BYOK) @map("key_mode")
  /// Explicit MANAGED-mode offer flag per connection — OFF by default.
  managedModeEnabled   Boolean                  @default(false) @map("managed_mode_enabled")
  scopes               String[]                 @default([])
  tokenExpiresAt       DateTime?                @map("token_expires_at")
  lastHealthCheckAt    DateTime?                @map("last_health_check_at")
  lastHealthOk         Boolean?                 @map("last_health_ok")
  lastError            String?                  @map("last_error")
  connectedByUserId    String?                  @map("connected_by_user_id")
  legacySource         String?                  @map("legacy_source")
  legacySourceId       String?                  @map("legacy_source_id")
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("TenantIntegrationConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, providerId, externalKey])
  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@map("tenant_integrations")
}

/// Metered usage events (S1 shadow + future enforcement).
model UsageEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metric         String
  quantity       Int      @default(1)
  periodStart    DateTime @map("period_start") @db.Date
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id")
  idempotencyKey String?  @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metric, periodStart])
  @@index([createdAt])
  @@map("usage_events")
}

// ─── S2: Credits ledger ──────────────────────────────────────────────────────

enum CreditLedgerType {
  GRANT_PLAN
  GRANT_MANUAL
  PURCHASE
  CONSUME
  RESERVE
  COMMIT
  REFUND
  EXPIRE
  ADJUST
}

enum CreditKeyMode {
  BYOK
  MANAGED
}

model CreditPrice {
  id         String        @id @default(uuid())
  actionType String        @map("action_type")
  keyMode    CreditKeyMode @default(BYOK) @map("key_mode")
  credits    Int
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([actionType, keyMode])
  @@index([actionType])
  @@map("credit_prices")
}

/// Append-only credit ledger. Amounts are signed (+grant / -consume/reserve).
/// RESERVE deducts immediately; COMMIT is amount 0; REFUND returns credits.
model CreditLedgerEntry {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  type                 CreditLedgerType
  /// Signed: + grant/refund, - reserve/consume, 0 commit
  amount               Int
  balanceAfter         Int              @map("balance_after")
  actionType           String?          @map("action_type")
  referenceType        String?          @map("reference_type")
  referenceId          String?          @map("reference_id")
  /// Globally unique — one COMMIT or one REFUND per reservation via `:commit` / `:refund` suffix
  idempotencyKey       String           @unique @map("idempotency_key")
  /// For RESERVE rows: links outcomes; for COMMIT/REFUND: parent reserve key
  reserveIdempotencyKey String?         @map("reserve_idempotency_key")
  actorUserId          String?          @map("actor_user_id")
  reason               String?
  metadata             Json?
  createdAt            DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([reserveIdempotencyKey])
  @@index([referenceType, referenceId])
  @@map("credit_ledger_entries")
}

enum BillingAuthStatus {
  AUTHORIZED
  COMMITTED
  REFUNDED
  EXPIRED
}

/// S2.5 in-flight authorizations (committed usage + open auth must not exceed limits).
model BillingAuthorization {
  id                        String            @id @default(uuid())
  organizationId            String            @map("organization_id")
  actionType                String            @map("action_type")
  featureKey                String            @map("feature_key")
  metric                    String?
  quantity                  Int               @default(1)
  credits                   Int               @default(0)
  status                    BillingAuthStatus @default(AUTHORIZED)
  /// Links to CreditLedgerEntry RESERVE idempotency key when credits > 0
  reservationIdempotencyKey String?           @unique @map("reservation_idempotency_key")
  idempotencyKey            String            @unique @map("idempotency_key")
  referenceType             String?           @map("reference_type")
  referenceId               String?           @map("reference_id")
  periodStart               DateTime          @map("period_start") @db.Date
  dayStart                  DateTime?         @map("day_start") @db.Date
  actorUserId               String?           @map("actor_user_id")
  purpose                   String?
  expiresAt                 DateTime?         @map("expires_at")
  metadata                  Json?
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, featureKey])
  @@index([organizationId, status, dayStart])
  @@index([expiresAt])
  @@map("billing_authorizations")
}

/// Per-tenant entitlement overrides (plan ∪ override). UI in B2.
model OrgEntitlementOverride {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  key            String
  limitValue     Int?      @map("limit_value")
  /// null = do not override plan enabled flag
  enabled        Boolean?
  reason         String?
  setByUserId    String?   @map("set_by_user_id")
  /// B2: optional expiry — lifecycle job removes when past
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("org_entitlement_overrides")
}

/// B2: credit top-up packs (purchase in B3; SA grant + "Contact us" in B2).
model TopUpPack {
  id          String    @id @default(uuid())
  name        String
  credits     Int
  price       Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  active      Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  providerPriceMaps ProviderPriceMap[]

  @@index([active])
  @@index([archivedAt])
  @@map("top_up_packs")
}

/// B2: when limits drop below usage, tenant gets a notice window to choose what stays.
model PlanLimitNotice {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  featureKey      String                @map("feature_key")
  allowedCount    Int                   @map("allowed_count")
  planVersionId   String?               @map("plan_version_id")
  status          PlanLimitNoticeStatus @default(PENDING)
  noticeAt        DateTime              @map("notice_at")
  deadlineAt      DateTime              @map("deadline_at")
  /// Resource ids the tenant chose to keep active
  selectedIds     String[]              @default([]) @map("selected_ids")
  resolvedAt      DateTime?             @map("resolved_at")
  appliedAt       DateTime?             @map("applied_at")
  emailStubSentAt DateTime?             @map("email_stub_sent_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planVersion  PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([deadlineAt])
  @@index([featureKey])
  @@map("plan_limit_notices")
}

/// Every super-admin write is audited here.
model PlatformAuditLog {
  id             String   @id @default(uuid())
  actorUserId    String?  @map("actor_user_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  organizationId String?  @map("organization_id")
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?         @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([action])
  @@map("platform_audit_logs")
}
