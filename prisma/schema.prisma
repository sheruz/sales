model Icp {
  id                   String            @id @default(uuid())
  organizationId       String            @map("organization_id")
  name                 String
  description          String?
  industries           String[]          @default([])
  countries            String[]          @default([])
  regions              String[]          @default([])
  companySizes         String[]          @default([]) @map("company_sizes")
