  fundingMax           Decimal?          @map("funding_max") @db.Decimal(14, 2)
  jobSignals           String[]          @default([]) @map("job_signals")
  buyingSignals        String[]          @default([]) @map("buying_signals")
  decisionMakerTitles  String[]          @default([]) @map("decision_maker_titles")
  exclusions           String[]          @default([])
  priority             Int               @default(0)
