  targetDeals        Int?              @map("target_deals")
  averageDealValue   Decimal?          @map("average_deal_value") @db.Decimal(14, 2)
  startDate          DateTime?         @map("start_date") @db.Date
  endDate            DateTime?         @map("end_date") @db.Date
  targetRegions      String[]          @default([]) @map("target_regions")
  targetIndustries   String[]          @default([]) @map("target_industries")
