// ─── Multi-tenancy (Phase 1) ─────────────────────────────────────────────────

model Organization {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  legalName       String?            @map("legal_name")
  website         String?
  status          OrganizationStatus @default(ACTIVE)
  timezone        String             @default("UTC")
  defaultCurrency String             @default("USD") @map("default_currency")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  members           OrganizationUser[]
  settings          OrganizationSettings?
  invitations       OrganizationInvitation[]
  companies         Company[]
  leads             Lead[]
  tags              Tag[]
  campaigns         Campaign[]
  services          Service[]
  serviceCaseStudies ServiceCaseStudy[]
  deals             Deal[]
  tasks             Task[]
  meetings          Meeting[]
  proposals         Proposal[]
  conversations     Conversation[]
  emailAccounts     EmailAccount[]
  inboxConversations InboxConversation[]
  messages          Message[]
  emailEvents       EmailEvent[]
  emailSuppressions EmailSuppression[]
  outreachSequences OutreachSequence[]
  discoveryJobs     LinkedInDiscoveryJob[]
  followUpJobs      FollowUpJob[]
  autopilotConfigs  AutopilotConfig[]
  userIntegrations  UserIntegration[]
  aiUsageLogs       AIUsageLog[]
  auditLogs         AuditLog[]
  sessions          Session[]
  businessProfile   BusinessProfile?
  businessBrainDocuments BusinessBrainDocument[]
  icps              Icp[]
  revenueGoals      RevenueGoal[]
  revenueEntries    Revenue[]
  contacts          Contact[]
  signals           Signal[]
  opportunities     Opportunity[]
  opportunitySources OpportunitySource[]
  sourceConnectors  SourceConnector[]
  sourceRuns        SourceRun[]
  offers            Offer[]
  opportunityOfferRecommendations OpportunityOfferRecommendation[]
  opportunityIntelligences OpportunityIntelligence[]
  aiRecommendations AiRecommendation[]
  learningEvents    LearningEvent[]
  subscriptions     Subscription[]
  usageRecords      UsageRecord[]
  agentGoals        AgentGoal[]
  agentRuns         AgentRun[]
  agentActions      AgentAction[]

  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

model Role {
  id        String    @id @default(uuid())
  key       String    @unique
  name      String
  scope     RoleScope
  isSystem  Boolean   @default(true) @map("is_system")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  permissions RolePermission[]
  members     OrganizationUser[]
  invitations OrganizationInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationUser {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  userId           String           @map("user_id")
  roleId           String           @map("role_id")
  status           MembershipStatus @default(ACTIVE)
  isPrimaryAdmin   Boolean          @default(false) @map("is_primary_admin")
  invitedAt        DateTime?        @map("invited_at")
  joinedAt         DateTime?        @map("joined_at")
  lastActiveAt     DateTime?        @map("last_active_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
  @@map("organization_users")
}

model OrganizationSettings {
  organizationId      String   @id @map("organization_id")
  timezone            String   @default("UTC")
  currency            String   @default("USD")
  locale              String   @default("en-US")
  defaultEmailAccount String?  @map("default_email_account")
  defaultAiProvider   String?  @map("default_ai_provider")
  defaultAiModel      String?  @map("default_ai_model")
  dailyEmailLimit     Int      @default(50) @map("daily_email_limit")
  dailyAiLimit        Int      @default(100) @map("daily_ai_limit")
  settings            Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  roleId         String           @map("role_id")
  invitedById    String           @map("invited_by")
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@index([status])
  @@map("organization_invitations")
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  /// Legacy role kept for backward compatibility; org membership uses Role via OrganizationUser
  role         UserRole @default(SALES_REPRESENTATIVE)
  isActive     Boolean  @default(true) @map("is_active")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  assignedLeads     Lead[]           @relation("AssignedLeads")
  createdLeads      Lead[]           @relation("CreatedLeads")
  notes             Note[]
  tasks             Task[]           @relation("AssignedTasks")
  createdTasks      Task[]           @relation("CreatedTasks")
  activities        Activity[]
  deals             Deal[]
  meetings          Meeting[]
  proposals         Proposal[]
  aiConversations   AIConversation[]
  auditLogs         AuditLog[]
  sessions          Session[]
  lockedLeads       Lead[]               @relation("LockedLeads")
  linkedInJobs      LinkedInDiscoveryJob[]
  linkedInAccount   LinkedInAccount?
  autopilotConfig   AutopilotConfig?
  userIntegrations  UserIntegration[]
  outreachSettings  UserOutreachSettings?
  memberships       OrganizationUser[]
  invitationsSent   OrganizationInvitation[] @relation("InvitationsSent")
  passwordResets    PasswordResetToken[]
  businessBrainDocuments BusinessBrainDocument[] @relation("BrainDocumentAuthor")
  businessBrainVersions  BusinessBrainVersion[]  @relation("BrainVersionAuthor")
  ownedOpportunities     Opportunity[]           @relation("OpportunityOwner")
  opportunityEvents      OpportunityEvent[]      @relation("OpportunityEventActor")
  emailAccounts          EmailAccount[]
  assignedInboxConversations InboxConversation[] @relation("InboxAssignee")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  token                 String   @unique
  expiresAt             DateTime @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")
  ipAddress             String?  @map("ip_address")
  userAgent             String?  @map("user_agent")
  activeOrganizationId  String?  @map("active_organization_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Companies ───────────────────────────────────────────────────────────────
// Prospect buyer accounts (not SaaS tenants). Extended in Phase 3.

model Company {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  domain         String?
  website        String?
  industry       String?
  description    String?
  country        String?
  state          String?
  city           String?
  employeeCount  Int?          @map("employee_count")
  /// Legacy company_size / employee_range
  size           String?       @map("company_size")
  employeeRange  String?       @map("employee_range")
  revenueRange   String?       @map("revenue_range")
  foundedYear    Int?          @map("founded_year")
  linkedInUrl    String?       @map("linkedin_url")
  instagramUrl   String?       @map("instagram_url")
  facebookUrl    String?       @map("facebook_url")
  technologies   String[]      @default([])
  fundingTotal   Decimal?      @map("funding_total") @db.Decimal(14, 2)
  lastFundingDate DateTime?    @map("last_funding_date") @db.Date
  status         CompanyStatus @default(ACTIVE)
  source         String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads         Lead[]
  deals         Deal[]
  contacts      Contact[]
  signals       Signal[]
  opportunities Opportunity[]
  inboxConversations InboxConversation[]
  tasks         Task[]
  meetings      Meeting[]
  proposals     Proposal[]

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([name])
  @@index([industry])
  @@index([status])
  @@map("companies")
}

model Contact {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  companyId      String        @map("company_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  fullName       String        @map("full_name")
  title          String?
  department     String?
  seniority      String?
  email          String?
  emailStatus    String?       @map("email_status")
  phone          String?
  linkedInUrl    String?       @map("linkedin_url")
  source         String?
  verifiedAt     DateTime?     @map("verified_at")
  status         ContactStatus @default(ACTIVE)
  metadata       Json?
  /// Optional bridge to legacy Lead for automation/conversations
  leadId         String?       @unique @map("lead_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead                  Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  primaryOpportunities  Opportunity[] @relation("PrimaryContact")
  recommendedForOpportunities Opportunity[] @relation("RecommendedContact")
  inboxConversations InboxConversation[]
  primaryDeals Deal[] @relation("DealPrimaryContact")
  tasks        Task[]
  meetings     Meeting[]
  proposals    Proposal[]

  @@index([organizationId])
  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model OpportunitySource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signals       Signal[]
  opportunities Opportunity[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("opportunity_sources")
}

/// Provider-independent source connector (Phase 4)
model SourceConnector {
  id                    String                @id @default(uuid())
  organizationId        String                @map("organization_id")
  type                  SourceConnectorType
  name                  String
  provider              String
  status                SourceConnectorStatus @default(DISCONNECTED)
  credentialsEncrypted  String?               @map("credentials_encrypted")
  configuration         Json?
  lastSyncAt            DateTime?             @map("last_sync_at")
  lastError             String?               @map("last_error")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         SourceRun[]
  signals      Signal[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@unique([organizationId, type, provider, name])
  @@map("source_connectors")
}

model SourceRun {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  sourceConnectorId String         @map("source_connector_id")
  status            SourceRunStatus @default(PENDING)
  startedAt         DateTime?      @map("started_at")
  completedAt       DateTime?      @map("completed_at")
  recordsFound      Int            @default(0) @map("records_found")
  recordsCreated    Int            @default(0) @map("records_created")
  recordsUpdated    Int            @default(0) @map("records_updated")
  recordsFailed     Int            @default(0) @map("records_failed")
  recordsSkipped    Int            @default(0) @map("records_skipped")
  error             String?
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceConnector SourceConnector @relation(fields: [sourceConnectorId], references: [id], onDelete: Cascade)
  signals         Signal[]

  @@index([organizationId])
  @@index([sourceConnectorId])
  @@index([status])
  @@index([createdAt])
  @@map("source_runs")
}

model Signal {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  companyId         String       @map("company_id")
  sourceId          String?      @map("source_id")
  sourceConnectorId String?      @map("source_connector_id")
  sourceRunId       String?      @map("source_run_id")
  type              SignalType
  title             String
  description       String?
  evidenceUrl       String?      @map("evidence_url")
  evidenceText      String?      @map("evidence_text")
  confidence        Int          @default(50)
  /// Dedup key: org-scoped fingerprint of normalized signal content
  fingerprint       String?
  /// Provider-native ID when available
  externalId        String?      @map("external_id")
  detectedAt        DateTime     @default(now()) @map("detected_at")
  occurredAt        DateTime?    @map("occurred_at")
  expiresAt         DateTime?    @map("expires_at")
  status            SignalStatus @default(NEW)
  rawData           Json?        @map("raw_data")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source          OpportunitySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceConnector SourceConnector?   @relation(fields: [sourceConnectorId], references: [id], onDelete: SetNull)
  sourceRun       SourceRun?         @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  opportunities   Opportunity[]      @relation("OpportunityPrimarySignal")

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([detectedAt])
  @@index([sourceConnectorId])
  @@index([externalId])
  @@map("signals")
}

model Opportunity {
  id                       String            @id @default(uuid())
  organizationId           String            @map("organization_id")
  companyId                String            @map("company_id")
  primaryContactId         String?           @map("primary_contact_id")
  sourceId                 String?           @map("source_id")
  primarySignalId          String?           @map("primary_signal_id")
  /// Bridge to legacy Lead automation / conversations
  leadId                   String?           @unique @map("lead_id")
  status                   OpportunityStatus @default(OPEN)
  stage                    OpportunityStage  @default(NEW)
  score                    Int               @default(0)
  confidence               Int               @default(50)
  estimatedValue           Decimal?          @map("estimated_value") @db.Decimal(14, 2)
  currency                 String            @default("USD")
  urgency                  Int               @default(50)
  whyNow                   String?           @map("why_now")
  likelyProblem            String?           @map("likely_problem")
  recommendedServiceId     String?           @map("recommended_service_id")
  recommendedOfferId       String?           @map("recommended_offer_id")
  recommendedContactId     String?           @map("recommended_contact_id")
  recommendedContactReason String?           @map("recommended_contact_reason")
  recommendedContactConfidence Int?          @map("recommended_contact_confidence")
  outreachMessage          String?           @map("outreach_message")
  recommendedAction        String?           @map("recommended_action")
  intelligenceGeneratedAt  DateTime?         @map("intelligence_generated_at")
  lastSignalAt             DateTime?         @map("last_signal_at")
  nextActionAt             DateTime?         @map("next_action_at")
  ownerId                  String?           @map("owner_id")
  campaignId               String?           @map("campaign_id")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContact     Contact?           @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  recommendedContact Contact?           @relation("RecommendedContact", fields: [recommendedContactId], references: [id], onDelete: SetNull)
  source             OpportunitySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  primarySignal      Signal?            @relation("OpportunityPrimarySignal", fields: [primarySignalId], references: [id], onDelete: SetNull)
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  recommendedService Service?           @relation(fields: [recommendedServiceId], references: [id], onDelete: SetNull)
  recommendedOffer   Offer?             @relation(fields: [recommendedOfferId], references: [id], onDelete: SetNull)
  owner              User?              @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  events             OpportunityEvent[]
  scores             OpportunityScore[]
  offerRecommendations OpportunityOfferRecommendation[]
  intelligence       OpportunityIntelligence?
  inboxConversations InboxConversation[]
  tasks              Task[]
  meetings           Meeting[]
  proposals          Proposal[]
  deals              Deal[]
  learningEvents     LearningEvent[]

  @@index([organizationId])
  @@index([companyId])
  @@index([status])
  @@index([stage])
  @@index([score])
  @@index([ownerId])
  @@index([campaignId])
  @@index([lastSignalAt])
  @@index([nextActionAt])
  @@map("opportunities")
}

model OpportunityEvent {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  opportunityId  String               @map("opportunity_id")
  type           OpportunityEventType
  title          String?
  description    String?
  metadata       Json?
  actorId        String?              @map("actor_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor       User?       @relation("OpportunityEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("opportunity_events")
}

model OpportunityScore {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  opportunityId         String   @map("opportunity_id")
  totalScore            Int      @map("total_score")
  icpFit                Int      @map("icp_fit")
  signalStrength        Int      @map("signal_strength")
  freshness             Int
  urgency               Int
  budgetPotential       Int      @map("budget_potential")
  growth                Int
  serviceFit            Int      @map("service_fit")
  reachability          Int
  historicalConversion  Int      @map("historical_conversion")
  explanation           String
  model                 String?
  createdAt             DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("opportunity_scores")
}

// ─── Leads ───────────────────────────────────────────────────────────────────

model Lead {
  id                  String     @id @default(uuid())
  organizationId      String     @map("organization_id")
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  fullName            String     @map("full_name")
  email               String?
  phone               String?
  linkedInUrl         String?    @map("linkedin_url")
  companyName         String?    @map("company_name")
  companyWebsite      String?    @map("company_website")
  companyLinkedIn     String?    @map("company_linkedin")
  jobTitle            String?    @map("job_title")
  country             String?
  city                String?
  industry            String?
  companySize         String?    @map("company_size")
  companyDescription  String?    @map("company_description")
  source              String?
  campaignId          String?    @map("campaign_id")
  companyId           String?    @map("company_id")
  assignedToId        String?    @map("assigned_to_id")
  createdById         String?    @map("created_by_id")
  status              LeadStatus @default(NEW)
  score               Int        @default(0)
  scoreCategory       LeadScoreCategory? @map("score_category")
  estimatedBudget     Decimal?   @map("estimated_budget") @db.Decimal(12, 2)
  notes               String?
  unsubscribed        Boolean    @default(false)
  automationStatus    AutomationStatus @default(IDLE) @map("automation_status")
  lockedAt            DateTime?  @map("locked_at")
  lockedById          String?    @map("locked_by_id")
  nextAutomationAt    DateTime?  @map("next_automation_at")
  automationError     String?    @map("automation_error")
  automationMeta      Json?      @map("automation_meta")
  autoReplyEnabled    Boolean    @default(true) @map("auto_reply_enabled")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  assignedTo    User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy     User?          @relation("CreatedLeads", fields: [createdById], references: [id])
  lockedBy      User?          @relation("LockedLeads", fields: [lockedById], references: [id])
  tags          LeadTag[]
  leadNotes     Note[]
  tasks         Task[]
  activities    Activity[]
  researches    LeadResearch[]
  scores        LeadScore[]
  campaignLeads CampaignLead[]
  conversations Conversation[]
  deals         Deal[]
  meetings      Meeting[]
  proposals     Proposal[]
  followUpJobs  FollowUpJob[]
  contact       Contact?
  opportunity   Opportunity?
  inboxConversations InboxConversation[]

  @@index([organizationId])
  @@index([automationStatus])
  @@index([nextAutomationAt])
  @@index([status])
  @@index([score])
  @@index([scoreCategory])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([companyId])
  @@index([email])
  @@index([fullName])
  @@index([createdAt])
  @@map("leads")
}

// ─── Tags ────────────────────────────────────────────────────────────────────

model Tag {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model LeadTag {
  leadId String @map("lead_id")
  tagId  String @map("tag_id")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

// ─── Campaigns ───────────────────────────────────────────────────────────────

model Campaign {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  name              String
  description       String?
  targetAudience    String?        @map("target_audience")
  targetCountries   String[]       @map("target_countries")
  targetIndustries  String[]       @map("target_industries")
  serviceId         String?        @map("service_id")
  aiInstructions    String?        @map("ai_instructions")
  dailyOutreachLimit Int           @default(50) @map("daily_outreach_limit")
  status            CampaignStatus @default(DRAFT)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service          Service?           @relation(fields: [serviceId], references: [id])
  leads            Lead[]
  campaignLeads    CampaignLead[]
  followUpSequence FollowUpSequence?
  linkedInJobs     LinkedInDiscoveryJob[]
  autopilotConfigs AutopilotConfig[]
  opportunities    Opportunity[]

  @@index([organizationId])
  @@index([status])
  @@map("campaigns")
}

model CampaignLead {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  leadId     String   @map("lead_id")
  addedAt    DateTime @default(now()) @map("added_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@map("campaign_leads")
}

model LinkedInDiscoveryJob {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campaignId     String?   @map("campaign_id")
  createdById    String    @map("created_by_id")
  status         JobStatus @default(PENDING)
  searchCriteria Json?     @map("search_criteria")
  profileUrls    String[]  @map("profile_urls")
  targetCount    Int       @default(10) @map("target_count")
  leadsCreated   Int       @default(0) @map("leads_created")
  results        Json?
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([campaignId])
  @@map("linkedin_discovery_jobs")
}

// ─── AI Research & Scoring ───────────────────────────────────────────────────

model LeadResearch {
  id                     String   @id @default(uuid())
  leadId                 String   @map("lead_id")
  companySummary         String?  @map("company_summary")
  whatCompanyDoes        String?  @map("what_company_does")
  industry               String?
  businessChallenges     Json?    @map("business_challenges")
  softwareOpportunities  Json?    @map("software_opportunities")
  recommendedServices    Json?    @map("recommended_services")
  decisionMakerAnalysis  String?  @map("decision_maker_analysis")
  personalizationPoints  Json?    @map("personalization_points")
  suggestedOpeningMessage String? @map("suggested_opening_message")
  suggestedApproach      String?  @map("suggested_approach")
  leadScore              Int?     @map("lead_score")
  reasoning              String?
  rawResponse            Json?    @map("raw_response")
  isEdited               Boolean  @default(false) @map("is_edited")
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_research")
}

model LeadScore {
  id                String            @id @default(uuid())
  leadId            String            @map("lead_id")
  score             Int
  category          LeadScoreCategory
  explanation       String?
  recommendedAction String?           @map("recommended_action")
  factors           Json?
  createdAt         DateTime          @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_scores")
}

// ─── Notes & Tasks ───────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("notes")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  title          String
  description    String?
  type           TaskType     @default(OTHER)
  leadId         String?      @map("lead_id")
  dealId         String?      @map("deal_id")
  opportunityId  String?      @map("opportunity_id")
  companyId      String?      @map("company_id")
  contactId      String?      @map("contact_id")
  assignedToId   String?      @map("assigned_to_id")
  createdById    String?      @map("created_by_id")
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    User?        @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

// ─── Activities & Conversations ──────────────────────────────────────────────

model Activity {
  id          String       @id @default(uuid())
  leadId      String?      @map("lead_id")
  dealId      String?      @map("deal_id")
  userId      String?      @map("user_id")
  type        ActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal Deal? @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model Conversation {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  leadId         String              @map("lead_id")
  channel        ConversationChannel
  subject        String?
  content        String?
  summary        String?
  metadata       Json?
  isInbound      Boolean             @default(false) @map("is_inbound")
  classification ReplyClassification?
  aiAnalysis     Json?               @map("ai_analysis")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([channel])
  @@index([createdAt])
  @@map("conversations")
}

// ─── Email / Unified Inbox (Phase 6) ─────────────────────────────────────────
// Legacy `Conversation` (lead outreach log) remains above for automation.
// InboxConversation + Message are the unified Gmail/Outlook/SMTP inbox.

model EmailAccount {
  id                      String             @id @default(uuid())
  organizationId          String             @map("organization_id")
  userId                  String             @map("user_id")
  provider                EmailProvider
  email                   String
  displayName             String?            @map("display_name")
  status                  EmailAccountStatus @default(ACTIVE)
  encryptedAccessToken    String?            @map("encrypted_access_token")
  encryptedRefreshToken   String?            @map("encrypted_refresh_token")
  tokenExpiresAt          DateTime?          @map("token_expires_at")
  smtpHost                String?            @map("smtp_host")
  smtpPort                Int?               @map("smtp_port")
  smtpSecure              Boolean?           @map("smtp_secure")
  smtpUser                String?            @map("smtp_user")
  encryptedSmtpPassword   String?            @map("encrypted_smtp_password")
  dailyLimit              Int                @default(50) @map("daily_limit")
  dailySent               Int                @default(0) @map("daily_sent")
  dailySentResetAt        DateTime?          @map("daily_sent_reset_at")
  lastSyncAt              DateTime?          @map("last_sync_at")
  syncCursor              String?            @map("sync_cursor")
  lastError               String?            @map("last_error")
  isDefault               Boolean            @default(false) @map("is_default")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations InboxConversation[]
  messages      Message[]
  events        EmailEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("email_accounts")
}

/// Unified inbox conversation (Phase 6 conversations entity)
model InboxConversation {
  id               String                  @id @default(uuid())
  organizationId   String                  @map("organization_id")
  companyId        String?                 @map("company_id")
  contactId        String?                 @map("contact_id")
  opportunityId    String?                 @map("opportunity_id")
  leadId           String?                 @map("lead_id")
  emailAccountId   String?                 @map("email_account_id")
  channel          ConversationChannel     @default(EMAIL)
  status           InboxConversationStatus @default(OPEN)
  sentiment        String?
  intent           String?
  subject          String?
  providerThreadId String?                 @map("provider_thread_id")
  lastMessageAt    DateTime?               @map("last_message_at")
  nextActionAt     DateTime?               @map("next_action_at")
  assignedToId     String?                 @map("assigned_to")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("InboxAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     Message[]
  events       EmailEvent[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([providerThreadId])
  @@map("inbox_conversations")
}

model Message {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  conversationId      String                   @map("conversation_id")
  emailAccountId      String?                  @map("email_account_id")
  direction           MessageDirection
  providerMessageId   String?                  @map("provider_message_id")
  threadId            String?                  @map("thread_id")
  subject             String?
  body                String?
  bodyHtml            String?                  @map("body_html")
  fromEmail           String?                  @map("from_email")
  toEmail             String?                  @map("to_email")
  status              EmailStatus              @default(DRAFT)
  aiClassification    MessageAiClassification? @map("ai_classification")
  aiSummary           String?                  @map("ai_summary")
  suggestedNextAction String?                  @map("suggested_next_action")
  idempotencyKey      String?                  @map("idempotency_key")
  sentAt              DateTime?                @map("sent_at")
  receivedAt          DateTime?                @map("received_at")
  metadata            Json?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation InboxConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount?       @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  events       EmailEvent[]
  attachments  MessageAttachment[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, providerMessageId])
  @@index([organizationId])
  @@index([conversationId])
  @@index([direction])
  @@index([status])
  @@index([threadId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  filename  String
  mimeType  String   @map("mime_type")
  size      Int
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model EmailEvent {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  messageId       String?        @map("message_id")
  conversationId  String?        @map("conversation_id")
  emailAccountId  String?        @map("email_account_id")
  type            EmailEventType
  providerEventId String?        @map("provider_event_id")
  recipientEmail  String?        @map("recipient_email")
  metadata        Json?
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation InboxConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount?      @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([messageId])
  @@index([type])
  @@index([occurredAt])
  @@map("email_events")
}

model EmailSuppression {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  email          String?
  domain         String?
  reason         SuppressionReason
  source         String?
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([domain])
  @@index([reason])
  @@map("email_suppressions")
}

model OutreachSequence {
  id                String                 @id @default(uuid())
  organizationId    String                 @map("organization_id")
  name              String
  description       String?
  status            OutreachSequenceStatus @default(DRAFT)
  stopOnReply       Boolean                @default(true) @map("stop_on_reply")
  stopOnMeeting     Boolean                @default(true) @map("stop_on_meeting")
  stopOnUnsubscribe Boolean                @default(true) @map("stop_on_unsubscribe")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        OutreachSequenceStep[]

  @@index([organizationId])
  @@index([status])
  @@map("outreach_sequences")
}

model OutreachSequenceStep {
  id              String              @id @default(uuid())
  sequenceId      String              @map("sequence_id")
  stepOrder       Int                 @map("step_order")
  delayMinutes    Int                 @default(0) @map("delay_minutes")
  channel         ConversationChannel @default(EMAIL)
  subjectTemplate String?             @map("subject_template")
  bodyTemplate    String              @map("body_template")
  condition       Json?
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  sequence OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId])
  @@map("outreach_sequence_steps")
}

// ─── Follow-up Automation ────────────────────────────────────────────────────

model FollowUpSequence {
  id         String   @id @default(uuid())
  campaignId String   @unique @map("campaign_id")
  name       String
  steps      Json
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("follow_up_sequences")
}

model FollowUpJob {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  leadId         String            @map("lead_id")
  stepIndex      Int               @map("step_index")
  scheduledAt    DateTime          @map("scheduled_at")
  status         FollowUpJobStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3) @map("max_attempts")
  lastError      String?           @map("last_error")
  completedAt    DateTime?         @map("completed_at")
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([scheduledAt])
  @@index([leadId])
  @@map("follow_up_jobs")
}

model JobLog {
  id        String    @id @default(uuid())
  jobType   String    @map("job_type")
  jobId     String?   @map("job_id")
  status    JobStatus
  message   String?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@map("job_logs")
}

// ─── Deals & Pipeline ────────────────────────────────────────────────────────

model Deal {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  name              String
  leadId            String?   @map("lead_id")
  opportunityId     String?   @map("opportunity_id")
  companyId         String?   @map("company_id")
  primaryContactId  String?   @map("primary_contact_id")
  assignedToId      String?   @map("assigned_to_id")
  estimatedValue    Decimal   @map("estimated_value") @db.Decimal(12, 2)
  currency          String    @default("USD")
  probability       Int       @default(10)
  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")
  stage             DealStage @default(QUALIFIED)
  notes             String?
  wonAt             DateTime? @map("won_at")
  lostAt            DateTime? @map("lost_at")
  lostReason        String?   @map("lost_reason")
  wonReason         String?   @map("won_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact Contact?     @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])
  activities     DealActivity[]
  leadActivities Activity[]   @relation("DealActivities")
  tasks          Task[]
  proposals      Proposal[]
  meetings       Meeting[]
  revenueEntries Revenue[]

  @@index([organizationId])
  @@index([stage])
  @@index([assignedToId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([companyId])
  @@map("deals")
}

model DealActivity {
  id          String    @id @default(uuid())
  dealId      String    @map("deal_id")
  fromStage   DealStage? @map("from_stage")
  toStage     DealStage @map("to_stage")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_activities")
}

// ─── Meetings ────────────────────────────────────────────────────────────────

model Meeting {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  leadId         String?        @map("lead_id")
  opportunityId  String?        @map("opportunity_id")
  companyId      String?        @map("company_id")
  contactId      String?        @map("contact_id")
  dealId         String?        @map("deal_id")
  userId         String         @map("user_id")
  title          String
  description    String?
  /// Start time (legacy column name `date`)
  date           DateTime
  endAt          DateTime?      @map("end_at")
  duration       Int            @default(30)
  timezone       String         @default("UTC")
  location       String?
  type           MeetingType    @default(DISCOVERY)
  meetingLink    String?        @map("meeting_link")
  outcome        MeetingOutcome @default(SCHEDULED)
  notes          String?
  aiPrepNotes    Json?          @map("ai_prep_notes")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id])
  meetingNotes MeetingNote[]

  @@index([organizationId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([date])
  @@index([userId])
  @@map("meetings")
}

model MeetingNote {
  id              String   @id @default(uuid())
  meetingId       String   @map("meeting_id")
  content         String
  transcript      String?
  aiSummary       String?  @map("ai_summary")
  aiRequirements  Json?    @map("ai_requirements")
  aiNextSteps     Json?    @map("ai_next_steps")
  aiFollowUpDraft String?  @map("ai_follow_up_draft")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_notes")
}

// ─── Proposals ───────────────────────────────────────────────────────────────

model Proposal {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  leadId          String?        @map("lead_id")
  opportunityId   String?        @map("opportunity_id")
  companyId       String?        @map("company_id")
  contactId       String?        @map("contact_id")
  dealId          String?        @map("deal_id")
  createdById     String         @map("created_by_id")
  title           String
  status          ProposalStatus @default(DRAFT)
  currency        String         @default("USD")
  subtotal        Decimal?       @db.Decimal(12, 2)
  discount        Decimal?       @db.Decimal(12, 2)
  totalPrice      Decimal?       @map("total_price") @db.Decimal(12, 2)
  content         String?
  version         Int            @default(1)
  sentAt          DateTime?      @map("sent_at")
  viewedAt        DateTime?      @map("viewed_at")
  acceptedAt      DateTime?      @map("accepted_at")
  expiresAt       DateTime?      @map("expires_at")
  isPriceApproved Boolean        @default(false) @map("is_price_approved")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])
  versions     ProposalVersion[]

  @@index([organizationId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([status])
  @@map("proposals")
}

model ProposalVersion {
  id               String   @id @default(uuid())
  proposalId       String   @map("proposal_id")
  version          Int
  executiveSummary String?  @map("executive_summary")
  problemStatement String?  @map("problem_statement")
  proposedSolution String?  @map("proposed_solution")
  scopeOfWork      String?  @map("scope_of_work")
  features         Json?
  technologyStack  Json?    @map("technology_stack")
  timeline         String?
  deliverables     Json?
  pricingSection   String?  @map("pricing_section")
  assumptions      String?
  rawContent       Json?    @map("raw_content")
  createdAt        DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, version])
  @@map("proposal_versions")
}

model Revenue {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  dealId         String        @map("deal_id")
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  recognizedAt   DateTime      @default(now()) @map("recognized_at")
  source         RevenueSource @default(DEAL_WON)
  status         RevenueStatus @default(RECOGNIZED)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
  @@index([recognizedAt])
  @@index([status])
  @@map("revenue")
}

// ─── Services Configuration ──────────────────────────────────────────────────
// Extended in Phase 2 — do not create a second services table.

model Service {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  name             String
  description      String
  category         String?
  pricingModel     String?           @map("pricing_model")
  /// Legacy alias for minPrice — kept for backward compatibility
  minBudget        Decimal?          @map("min_budget") @db.Decimal(12, 2)
  /// Legacy alias for maxPrice
  maxBudget        Decimal?          @map("max_budget") @db.Decimal(12, 2)
  currency         String            @default("USD")
  /// Legacy delivery_time field
  typicalTimeline  String?           @map("typical_timeline")
  /// Legacy ideal customer summary
  targetClientType String?           @map("target_client_type")
  idealCustomer    String?           @map("ideal_customer")
  problemsSolved   String[]          @default([]) @map("problems_solved")
  technologies     String[]
  caseStudies      Json?             @map("case_studies")
  talkingPoints    Json?             @map("talking_points")
  status           CatalogItemStatus @default(ACTIVE)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  autopilotConfigs AutopilotConfig[]
  serviceCaseStudies ServiceCaseStudy[]
  opportunities    Opportunity[]
  offers           Offer[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
  @@map("services")
}

model Offer {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  serviceId      String      @map("service_id")
  name           String
  description    String?
  problem        String?
  solution       String?
  outcome        String?
  pricingModel   String?     @map("pricing_model")
  minValue       Decimal?    @map("min_value") @db.Decimal(14, 2)
  maxValue       Decimal?    @map("max_value") @db.Decimal(14, 2)
  currency       String      @default("USD")
  deliveryTime   String?     @map("delivery_time")
  status         OfferStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recommendations OpportunityOfferRecommendation[]
  opportunities  Opportunity[]
  intelligences  OpportunityIntelligence[]

  @@index([organizationId])
  @@index([serviceId])
  @@index([status])
  @@map("offers")
}

model OpportunityOfferRecommendation {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  opportunityId  String                    @map("opportunity_id")
  offerId        String                    @map("offer_id")
  confidence     Int                       @default(50)
  fitReason      String?                   @map("fit_reason")
  expectedValue  Decimal?                  @map("expected_value") @db.Decimal(14, 2)
  explanation    String?
  status         OfferRecommendationStatus @default(SUGGESTED)
  createdAt      DateTime                  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([opportunityId])
  @@index([offerId])
  @@map("opportunity_offer_recommendations")
}

/// Concise AI sales intelligence for an opportunity (no private chain-of-thought)
model OpportunityIntelligence {
  id                           String   @id @default(uuid())
  organizationId               String   @map("organization_id")
  opportunityId                String   @unique @map("opportunity_id")
  whyNow                       String   @map("why_now")
  likelyProblem                String   @map("likely_problem")
  recommendedServiceId         String?  @map("recommended_service_id")
  recommendedOfferId           String?  @map("recommended_offer_id")
  recommendedContactId         String?  @map("recommended_contact_id")
  recommendedContactReason     String?  @map("recommended_contact_reason")
  recommendedContactConfidence Int?     @map("recommended_contact_confidence")
  outreachMessage              String?  @map("outreach_message")
  recommendedAction            String?  @map("recommended_action")
  offerTitle                   String?  @map("offer_title")
  offerProblem                 String?  @map("offer_problem")
  offerSolution                String?  @map("offer_solution")
  offerScope                   String?  @map("offer_scope")
  offerExpectedOutcome         String?  @map("offer_expected_outcome")
  offerEstimatedValue          Decimal? @map("offer_estimated_value") @db.Decimal(14, 2)
  offerReasoning               String?  @map("offer_reasoning")
  relevantCaseStudyId          String?  @map("relevant_case_study_id")
  scoreBreakdown               Json?    @map("score_breakdown")
  summary                      String?
  model                        String?
  generatedAt                  DateTime @default(now()) @map("generated_at")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendedOffer Offer?   @relation(fields: [recommendedOfferId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("opportunity_intelligences")
}

model ServiceCaseStudy {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  serviceId        String   @map("service_id")
  title            String
  customerIndustry String?  @map("customer_industry")
  problem          String?
  solution         String?
  outcome          String?
  metrics          Json?
  content          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([serviceId])
  @@map("service_case_studies")
}

// ─── Business Brain (Phase 2) ────────────────────────────────────────────────

model BusinessProfile {
  id                     String   @id @default(uuid())
  organizationId         String   @unique @map("organization_id")
  companyName            String   @map("company_name")
  description            String?
  website                String?
  industry               String?
  locations              String[] @default([])
  targetMarkets          String[] @default([]) @map("target_markets")
  companySize            String?  @map("company_size")
  yearsInBusiness        Int?     @map("years_in_business")
  positioning            String?
  valueProposition       String?  @map("value_proposition")
  competitiveAdvantages  String[] @default([]) @map("competitive_advantages")
  metadata               Json?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model BusinessBrainDocument {
  id           String              @id @default(uuid())
  organizationId String            @map("organization_id")
  type         BrainDocumentType
  title        String
  content      String
  sourceType   String?             @map("source_type")
  sourceUrl    String?             @map("source_url")
  status       BrainDocumentStatus @default(DRAFT)
  createdById  String?             @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

